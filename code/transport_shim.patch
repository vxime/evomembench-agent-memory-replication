+            [api_key, base_url, timeout, 0],
+        )))
+        completions = _Namespace(create=lambda **kwargs: client.chat.completions.create(**kwargs))
+        chat = _Namespace(completions=completions)
+        self.batch = _Namespace(chat=chat)
